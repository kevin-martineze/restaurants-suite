# API propia (restaurants-api) con su prefijo de versión.
API_URL=http://localhost:3100/v1

# Mapas del checkout. Los servidores públicos de OpenStreetMap sirven para
# desarrollo y el piloto; en producción va un proveedor (MapTiler, Stadia…).
PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap

# Cifra la cookie de sesión del panel. Mínimo 32 caracteres (`openssl rand -base64 48`).
SESSION_SECRET=solo-para-desarrollo-cambiar-en-produccion-panel
